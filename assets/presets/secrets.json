{
  "id": "secrets",
  "description": "禁止读取、改写或通过命令外发密钥与凭据文件",
  "rules": [
    {
      "id": "secrets-read",
      "kind": "read-protect",
      "paths": [
        ".env",
        "**/.env",
        ".env.local",
        "**/.env.local",
        ".env.*.local",
        "**/.env.*.local",
        ".env.dev-infra",
        "**/.env.dev-infra",
        ".env.test-infra",
        "**/.env.test-infra",
        "**/*.pem",
        "**/*.key",
        "**/id_rsa*",
        "**/credentials*.json"
      ],
      "allow": [
        ".env.example",
        ".env.minimal.example",
        ".env.dev-infra.example",
        ".env.test-infra.example"
      ],
      "reason": "禁止读取、复制或外发 .env、私钥和凭据文件内容",
      "fix": "只读同名 .example 文件了解变量名；核对变量是否齐全用项目自带的配置检查命令；确需真实值请用户提供脱敏信息"
    },
    {
      "id": "secrets-write",
      "kind": "write-protect",
      "paths": [
        ".env",
        "**/.env",
        ".env.local",
        "**/.env.local",
        ".env.*.local",
        "**/.env.*.local",
        ".env.dev-infra",
        "**/.env.dev-infra",
        ".env.test-infra",
        "**/.env.test-infra",
        "**/*.pem",
        "**/*.key",
        "**/id_rsa*",
        "**/credentials*.json"
      ],
      "allow": [],
      "reason": "本地环境文件、私钥与凭据文件由用户自己维护，不由 Agent 写入",
      "fix": "只改同名 .example 文件并在汇报里说明，由用户写入或生成真实凭据"
    },
    {
      "id": "secrets-shell",
      "kind": "shell-secret-access",
      "allowVerbs": [
        "git",
        "ls",
        "stat",
        "test",
        "["
      ],
      "patterns": [
        "\\.env\\.(local|test-infra|dev-infra)\\b",
        "(^|[\\s=\"'/])\\.env(?!\\.[A-Za-z0-9_.-]*example)(\\.[A-Za-z0-9_.-]+)?(\\s|$|[\"';|&)])",
        "\\.env\\.[A-Za-z0-9_.-]*local\\b",
        "\\.pem\\b",
        "id_rsa",
        "credentials[A-Za-z0-9_.-]*\\.json",
        "\\.local/share/harness/(evidence\\.key|retired/)"
      ],
      "reason": "禁止通过命令读取、复制或外发 .env、私钥、凭据和证据密钥",
      "fix": "只读同名 .example 文件；确需真实值请用户提供脱敏信息"
    }
  ]
}
